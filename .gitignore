__pycache__/
*.pyc
tarefas.db

# Artefatos de build
build/
dist/
*.spec.bak

# Testes
.pytest_cache/
.coverage
htmlcov/

# Instalador
installer/Output/

# Ambiente de quem desenvolve: editor e segredos locais. Nada disto diz
# respeito a outra pessoa, e o .env nunca deve chegar ao repositório.
.env
.vscode/
.idea/
.DS_Store

# Áreas de trabalho que o Claude Code cria dentro do próprio repositório.
# São cópias da árvore: enquanto têm o ficheiro `.git`, o git trata-as como
# outro repositório e nem olha para lá; quando esse ficheiro desaparece — e
# desaparece, se a worktree for removida a meio — os ficheiros todos passam a
# aparecer por rastrear, e um `git add -A` distraído commita o projeto
# duplicado dentro de si mesmo.
#
# As skills do projeto são versionadas (`.claude/skills/`); para versionar
# mais configuração do Claude, acrescente outra excepção.
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/hooks/
!.claude/settings.json

# Estado de trabalho em curso da skill trabalho-profundo: é de uma sessão,
# não do projeto.
.trabalho/

# Código-fonte de dependências clonado para leitura (skill clonar-dependencias).
.dependencias/
