# Copiar para .env.local e preencher com os valores do projeto Supabase
# (Project Settings → API). A chave publicável é segura no browser: quem
# protege os dados é a RLS, não o segredo desta chave.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# URL pública da aplicação, para os links de confirmação e de convite.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
