# Copiar para .env.local e preencher com os valores do projeto Supabase
# (Project Settings → API). A chave publicável é segura no browser: quem
# protege os dados é a RLS, não o segredo desta chave.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# URL pública da aplicação, para os links de confirmação e de convite.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Copiloto (Claude). Só no servidor — nunca com o prefixo NEXT_PUBLIC_.
# Sem ela, a página do Copiloto explica que não está configurado.
ANTHROPIC_API_KEY=

# Emails (ADR-0019). Tudo só no servidor.
# Resend: https://resend.com — a chave e um remetente de um domínio verificado.
RESEND_API_KEY=
EMAIL_REMETENTE="Gerenciador de Tarefas <avisos@o-seu-dominio.com>"
# Chave de serviço do Supabase: usada SÓ pelas rotas de cron que entregam a fila.
SUPABASE_SERVICE_ROLE_KEY=
# Segredo que o Vercel Cron envia (Authorization: Bearer ...). Pelo menos 16 caracteres.
CRON_SECRET=
